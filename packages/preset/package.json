{
  "name": "@biugle/biu-preset",
  "version": "2.0.1",
  "description": "Official React layout presets for biu Portal and APP projects.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./sidebar": {
      "types": "./dist/sidebar.d.ts",
      "import": "./dist/sidebar.js"
    },
    "./topbar": {
      "types": "./dist/topbar.d.ts",
      "import": "./dist/topbar.js"
    },
    "./blank": {
      "types": "./dist/blank.d.ts",
      "import": "./dist/blank.js"
    },
    "./dashboard": {
      "types": "./dist/dashboard.d.ts",
      "import": "./dist/dashboard.js"
    },
    "./mobile": {
      "types": "./dist/mobile.d.ts",
      "import": "./dist/mobile.js"
    },
    "./custom": {
      "types": "./dist/custom.d.ts",
      "import": "./dist/custom.js"
    },
    "./toolbar": {
      "types": "./dist/toolbar.d.ts",
      "import": "./dist/toolbar.js"
    },
    "./sidebar.css": "./dist/styles.css",
    "./topbar.css": "./dist/styles.css",
    "./blank.css": "./dist/styles.css",
    "./dashboard.css": "./dist/styles.css",
    "./mobile.css": "./dist/styles.css",
    "./custom.css": "./dist/styles.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/sidebar.tsx src/topbar.tsx src/blank.tsx src/dashboard.tsx src/mobile.tsx src/custom.tsx src/toolbar.tsx --format esm --dts --clean && esbuild src/styles.css --bundle --minify --outfile=dist/styles.css",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@biugle/biu-i18n": "workspace:*",
    "@biugle/biu-router": "workspace:*",
    "@biugle/biu-runtime": "workspace:*",
    "@biugle/biu-store": "workspace:*",
    "@biugle/icons": "workspace:*",
    "@biugle/react-components": "workspace:*",
    "@biugle/watermark": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.24.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3"
  }
}
