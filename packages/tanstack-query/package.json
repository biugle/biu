{
  "name": "@biugle/tanstack-query",
  "version": "0.4.0",
  "description": "Framework-neutral TanStack Query contracts and the optional React bindings used by Biu applications.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts src/react.tsx --format esm --dts --clean",
    "typecheck": "tsc -p tsconfig.json",
    "test": "tsx --test test/*.test.ts test/*.test.tsx"
  },
  "dependencies": {
    "@tanstack/query-core": "^5.103.2"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.103.2",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-query": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.103.2",
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "tsx": "^4.19.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3"
  }
}
