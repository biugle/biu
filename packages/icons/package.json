{
  "name": "@biugle/icons",
  "version": "2.0.0",
  "description": "The official icon entry point for biu and its component ecosystem.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "lucide-react": "^1.44.0"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/biugle/biu.git",
    "directory": "packages/icons"
  },
  "homepage": "https://github.com/biugle/biu#readme",
  "bugs": {
    "url": "https://github.com/biugle/biu/issues"
  }
}
