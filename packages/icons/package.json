  },
  "dependencies": {
    "lucide-react": "^1.44.0"
  },
  "peerDependencies": {
    "react": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "react": "^19.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3"
  }
}
