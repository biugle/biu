{
  "name": "@biugle/biu-cli",
  "version": "0.3.0",
  "description": "CLI for generating, developing and building biu foundation projects.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "biu": "./bin/biu.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format esm --dts --clean",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@biugle/biu-router": "workspace:*",
    "@rsbuild/core": "^1.2.15",
    "@rsbuild/plugin-react": "^1.1.0",
    "execa": "^9.5.2",
    "fast-glob": "^3.3.2",
    "jiti": "^2.4.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
