{
  "name": "@biugle/react-components",
  "version": "1.0.1",
  "description": "Composable UI primitives, enterprise Pro components and body-mounted fire utilities for React.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ui": {
      "types": "./dist/ui.d.ts",
      "import": "./dist/ui.js"
    },
    "./pro": {
      "types": "./dist/pro.d.ts",
      "import": "./dist/pro.js"
    },
    "./styles.css": "./dist/styles.css",
    "./theme.default.css": "./dist/theme.default.css",
    "./locale/zh-CN.json": "./dist/locale/zh-CN.json",
    "./locale/en-US.json": "./dist/locale/en-US.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts src/ui.tsx src/pro.tsx --format esm --dts --clean && tailwindcss -i src/styles.css -o dist/styles.css --minify && cp src/theme.default.css dist/theme.default.css && mkdir -p dist/locale && cp src/locale/*.json dist/locale/",
    "typecheck": "tsc -p tsconfig.json",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@biugle/icons": "workspace:*",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-tooltip": "^1.2.8",
    "dayjs": "^1.11.13"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^30.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.17",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
