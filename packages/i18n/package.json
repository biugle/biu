{
  "name": "@biugle/biu-i18n",
  "version": "1.0.3",
  "description": "Framework-agnostic locale resources and runtime i18n utilities for biu.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc -p tsconfig.json",
    "test": "tsx --test test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/biugle/biu.git",
    "directory": "packages/i18n"
  },
  "homepage": "https://github.com/biugle/biu#readme",
  "bugs": {
    "url": "https://github.com/biugle/biu/issues"
  }
}
